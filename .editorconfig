root = true

[*]
end_of_line              = lf
insert_final_newline     = true
charset                  = utf-8
indent_size              = 2
indent_style             = space
trim_trailing_whitespace = true

[*.{js,ts,cjs}]
indent_size = 2

[*.{json}]
indent_size = 2

[*.{tf,hcl}]
indent_size = 2

[*.{py}]
indent_size = 4

[*.{sh}]
indent_size = 4

[*.{go}]
indent_style = tab

[Makefile]
indent_style = tab